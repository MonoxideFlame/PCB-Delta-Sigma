twgraphics_context design
# design
tweditobj sort
# 
set area [tweditobj bbox]
# 129.945000 49.790000 155.700000 77.245000
if {$area != ""} {
  twgraphics_context frame $area
}
# 129.945000 49.790000 155.700000 77.245000
twposition invert off
# 0
twredraw
# 
twwait
# 

# 
if {$run_tw} {
  ::twkicad::run_tw $dsn
  twexit 0
}

