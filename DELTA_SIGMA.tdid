set variable_die true
# true

# 

# 
set args $argv
# -w 6291545 -v -do /Users/billswartz7/version1/itools/bin/twkicad_results DELTA_SIGMA
set num_args [llength $args]
# 6
for {set i 0} {$i < $num_args} {incr i} {
  set arg_el [lindex $args $i]
  if {$arg_el == "-debug" } {
    set debug 1
    puts stdout "debug mode enabled.\n"
    flush stdout
  } elseif {$arg_el == "-fixed_die" } {
    puts stdout "fixed die mode enabled.\n"
    flush stdout
    set variable_die 0
  } elseif {$arg_el == "-help" } {
    puts stderr "Usage:"
    puts stderr "  twkicad_results \[-debug] \[-fixed_die]"
    exit 0
  } else {
    set design $arg_el
  }
}
# 

# 
twkicad_write::write_results $design $variable_die $debug
