proc create_fdo {filename} {
  set f [open $filename "w"]
  if {$f == ""} {
    twmessage errmsg create_fdo "could not open file:$filename\n"
    return 
  }
  # Created by tcl2grand from decoder_signal.fdo on Tue Dec 15 12:44:33 2020
  puts $f ""
  puts $f ""
  puts $f "twwait"
  puts $f "twfloorplan"
  puts $f "twwait"
  puts $f ""
  puts $f ""
  close $f
}
# 

# 

# 

# 
if {$pcb_size != ""} {
  set core_size [split $pcb_size x]
  set xdim [lindex $core_size 0]
  set ydim [lindex $core_size 1]
  # Kicad is in mm
  if {$pcb_units != "mm"} {
    set w [expr 25.4 * $xdim]
    set h [expr 25.4 * $ydim]
  } else {
    set w $xdim
    set h $ydim
  }
  twboundary set core [list 0 0 $w $h]
  puts stderr "core: [twboundary core]"
}
# 

# 
if {1} {
  icbackup_directory timberwolf
  cd timberwolf
  twwrite_par ${dsn}.par
  twwrite_lib ${dsn}.lib
  twwrite_ckt ${dsn}.ckt

  twwrite_con ${dsn}.con
  if {$pcb_type == "double-sided"} {
    set fp [open ${dsn}.con a]
    if {$fp != ""} {
      foreach part $plane1_parts {
	puts $fp "PLANE $part RESTRICT 1"
      }
      foreach part $plane2_parts {
	puts $fp "PLANE $part RESTRICT 2"
      }
      close $fp
    }
  }
  twkicad::create_ddo ${dsn}.ddo -special_spacing 0.20 -max_width 0.8
  create_fdo ${dsn}.fdo
  # twkicad::create_fdo ${dsn}.fdo
}
