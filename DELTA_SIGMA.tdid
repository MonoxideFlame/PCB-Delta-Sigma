if {[info exists env(TWDIR)]} {
  set icdirG $env(TWDIR)
} elseif {[info exists env(ICDIR)]} {
  set icdirG $env(ICDIR)
} else {
  puts stderr "ERROR:cannot get TimberWolf/iTools environment variable:TWDIR/ICDIR"
  exit 1
}
# /Users/billswartz7/version1/itools
lappend auto_path $icdirG/tcl/common
# /Users/billswartz7/version1/itools/tcl/libtcl /Users/billswartz7/version1/itools/tcl ./lib /Users/billswartz7/version1/itools/tcl/tcl8.6/lib /Users/billswartz7/version1/itools/tcl/translate /Users/billswartz7/version1/itools/tcl/common /Users/billswartz7/version1/itools/tcl/common

