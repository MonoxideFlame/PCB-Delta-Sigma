V4 Net-_U4-_LE_ 0 PULSE( 0 3.3 0 1n 1n 990n 1000n ) 
U2 __U2
U4 __U4
U1 __U1
C4 Net-_U2A-+IN_ Net-_U2A--FB_ 1n
R7 Net-_U2A-+IN_ Net-_U4-_Q_ 10k
C3 Net-_U1A-+IN_ Net-_U1A--FB_ 1n
V3 INPUT 0 DC 1.6 SIN( 1.6 0.5 1k 0 0 0 ) AC 1  
R4 Net-_U1A-VOCM_ Net-_U1A-+IN_ 33k
